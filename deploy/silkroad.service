[Unit]
Description=Silk Road Flask App (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/silkroad
EnvironmentFile=/var/www/silkroad/.env
ExecStart=/var/www/silkroad/venv/bin/gunicorn -c /var/www/silkroad/gunicorn.conf.py wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
